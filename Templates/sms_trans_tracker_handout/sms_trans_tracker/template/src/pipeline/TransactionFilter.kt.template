// =============================================================================
// TransactionFilter — THE HEAVIEST FILE IN THE PORT.
//
// Model call + every guardrail. India's version is ~450 lines. This skeleton
// keeps the ORDER OF OPERATIONS and the reasoning; you fill in the regexes and
// word lists from RegionProfile.
//
// ** THE ONE RULE: THE MODEL NEVER DECIDES ALONE. **
// Every field the model emits is validated, repaired or vetoed here against the
// raw message text. That is why a wrong span becomes a DROPPED ROW instead of a
// WRONG BALANCE shown to a user. A new region's model is weaker than India's at
// first; this layer is what makes that survivable. Do not ship model output raw.
//
// This layer is ALSO the complete extractor when RegionProfile.useMlParser is
// false — a legitimate ship state. See ../../MODEL_TRAINING.md.
//
// India reference: ../../../src/pipeline/BankTransactionFilterMl.kt
// =============================================================================

/**
 * KEEP: the Android-free seam. Keeps the parser unit-testable with no emulator
 * and lets you feed corpus rows straight through in a JVM test.
 */
interface SmsFilterContext {
    fun openAsset(fileName: String): java.io.InputStream
    suspend fun bankNameFromBody(body: String): Pair<String, String>
    suspend fun merchantFromBody(body: String): String
    val region: RegionProfile
}

/**
 * KEEP: ONE parser instance for the process. Loading the weights is expensive;
 * parse() is reentrant (GruCell is per-call) so a single instance is safe.
 */
object ParserHolder {
    @Volatile private var instance: SmsParser? = null

    fun get(env: SmsFilterContext): SmsParser =
        instance ?: synchronized(this) {
            instance ?: buildParser(env).also { instance = it }
        }

    private fun buildParser(env: SmsFilterContext): SmsParser {
        TODO("load ModelWeights from env.openAsset(region.modelAssetName), build Tokenizer(region)")
    }
}

/**
 * KEEP: last account seen per bank, so messages that carry NO account (mandate
 * notices, statements) can inherit one.
 *
 * Order matters: fed in CHRONOLOGICAL order by the batch engine, not arrival
 * order. Getting that wrong attaches transactions to the wrong account.
 */
object AccountMemory {
    private val byBank = java.util.concurrent.ConcurrentHashMap<String, MutableSet<String>>()

    private fun norm(key: String) = key.uppercase().replace(Regex("[^A-Z]"), "")

    fun remember(keys: List<String?>, account: String) { TODO() }
    fun recall(keys: List<String?>): String? = TODO()
    fun clear() = byBank.clear()
}

// =============================================================================
// Row-level veto rules.
//
// Each of these exists because it produced WRONG DATA in production. The word
// lists are regional (RegionProfile.vocabulary); the RULES are universal — every
// market sends OTPs, declines, reminders and recurring-payment notices.
// =============================================================================
class TransactionRowValidator(private val region: RegionProfile) {

    private val v get() = region.vocabulary

    /**
     * KEEP THIS DISTINCTION — it is the easiest thing in the whole port to get
     * backwards, and getting it backwards inflates every user's balance.
     *
     * Only mandate CREATION / CANCELLATION notices are non-transactions.
     * An EXECUTED recurring debit ("199 debited as per mandate") is REAL money
     * movement and must be kept.
     *
     * IN-HINT: dropping executed autopay debits inflated the computed balance.
     * IN-HINT: cancel notices QUOTE the mandate amount, and that amount was
     *          landing in the balance field and anchoring the account to it.
     */
    fun isMandateNotice(body: String): Boolean {
        val hasMandate = v.mandateWords.any { body.contains(it, ignoreCase = true) }
        if (!hasMandate) return false
        val created = v.mandateCreationVerbs.any { body.contains(it, ignoreCase = true) }
        val cancelled = v.mandateCancelVerbs.any { body.contains(it, ignoreCase = true) }
        return created || cancelled
    }

    fun isOtpNotice(body: String) = v.otpWords.any { body.contains(it, ignoreCase = true) }
    fun isDeclinedNotice(body: String) = v.declinedWords.any { body.contains(it, ignoreCase = true) }
    fun isReminderNotice(body: String) = v.reminderWords.any { body.contains(it, ignoreCase = true) }

    /**
     * KEEP: the model sometimes tags the AMOUNT span as the ACCOUNT. A row whose
     * "account" equals its own amount is garbage.
     */
    fun isAmountAsAccount(accountNumber: String, amount: String): Boolean = TODO()

    /** KEEP: same check against the body, using account-context words. */
    fun isAmountAsAccountInBody(accountNumber: String, body: String): Boolean = TODO()

    fun isInvalidRow(accountNumber: String, amount: String, body: String): Boolean =
        isAmountAsAccount(accountNumber, amount) ||
            isAmountAsAccountInBody(accountNumber, body) ||
            isOtpNotice(body) || isDeclinedNotice(body) ||
            isReminderNotice(body) || isMandateNotice(body)
}

// =============================================================================
// Numeric repair — the model proposes, the raw text decides.
// =============================================================================

/**
 * KEEP THIS GUARD IN EVERY REGION, even if your grouping is uniform.
 *
 * A model value is trusted only if it appears in the body as a COMPLETE money
 * token. Catches truncation everywhere, and lakh-grouping damage in India.
 *
 * IN-HINT: Indian grouping ("INR.6,87,367.28") let the model emit ONE comma
 * group as the whole number — "6" as the amount, "87367" as the balance. Such a
 * fragment appears nowhere in the body as a complete token, so the regex reading
 * wins and the row is repaired instead of saved wrong.
 *
 * IN-HINT MONEY_TOKEN_RE: "(?<![A-Za-z0-9])\\d[\\d,]*(?:\\.\\d{1,2})?"
 *   The leading negative lookbehind matters: without it "CHQ0" offers a bare "0"
 *   token that would validate a garbage model amount of "00".
 *
 * TODO(REGION): rebuild from RegionProfile.currency separators/decimals.
 */
private fun isBodyMoneyToken(value: String, body: String, region: RegionProfile): Boolean {
    runCatching { BigDecimal(value) }.getOrNull() ?: return false
    TODO("match value against every complete money token in body")
}

