/** KEEP: same for balance, qualified pattern first then bare. */
private fun repairTruncatedBalance(modelValue: String, body: String): String = TODO()

/**
 * KEEP: cross-check amount against balance. If the model's amount and balance
 * are the same number, one of them is wrong — the body decides which.
 */
private fun repairAmountAgainstBalance(
    modelAmount: String, modelBalance: String, body: String,
): String = TODO()

// =============================================================================
// The extractor
// =============================================================================

/**
 * Returns null when this message is NOT a transaction. Null is the NORMAL,
 * EXPECTED result for most inbox messages — do not treat it as an error.
 *
 * ORDER OF OPERATIONS — keep it. Each step depends on the previous one.
 */
suspend fun transactionFilter(
    env: SmsFilterContext,
    body: String,
    address: String?,
    date: String,
    messageId: String,
    typeId: String,
    threadId: Long,
    cardNoCache: MutableCollection<String>,
): TransactionRow? {
    val region = env.region

    // 1. MODEL. Skipped entirely when useMlParser is false — every step below
    //    still runs, which is what makes regex-only a shippable configuration.
    val p = if (region.useMlParser) ParserHolder.get(env).parse(body, address ?: "") else null

    // 2. SENDER. Independent of the model — a lookup, not learned.
    val senderBank = region.senderScheme.resolve(address ?: "")
    val hasBankHint = senderBank != null || env.bankNameFromBody(body).first.isNotEmpty()

    // 3. VETO: no bank signal at all + a personal-looking number = not banking.
    //    TODO(REGION): "personal-looking" depends on your market's numbering.
    //    IN-HINT: strips spaces/+/- then treats a long digit run as personal.
    if (!hasBankHint) return null

    // 4. VETO: statement / minimum-due alerts. Money hasn't moved.
    //    TODO(REGION): translate. IN-HINT: "min.due", statement wording.

    // 5. CONFIDENCE GATE — is-transaction head only (see SmsParser).
    if (p != null && p.confidence < region.minConfidence) return null
    if (p != null && !p.isBankTxn) return null

    // 6. BANK + LOGO. Priority: sender resolver -> model BANK span -> body lookup.
    //    Sender wins because it is a fixed string, not an inference.
    val (bankName, logoKey) = TODO("resolve via senderBank, p?.bankSpan, env.bankNameFromBody")

    // 7. AMOUNT. Model span, repaired against body and balance, then formatted.
    //    TODO(REGION): formatting comes from RegionProfile.currency — symbol,
    //    POSITION (prefix vs suffix), separators, decimal places.
    //    IN-HINT: "₹ $amountNum" — prefix, hardcoded at 4 call sites in India's
    //    version. Route it through one formatter instead; that hardcoding is
    //    exactly what made the India code hard to port.
    val amount: String = TODO()

    // 8. ACCOUNT. Priority: body regex -> model span (normalized) ->
    //    AccountMemory.recall() for messages carrying no account at all.
    //    Plus: reject an "account" that is really the amount.
    val account: String = TODO()

    // 9. CARD OVERRIDE. A body that identifies itself as a CREDIT card message
    //    and carries a card-ending owns its own account, and source becomes CARD.
    //    KEEP the rule — any market with credit cards needs it.
    //    TODO(REGION): translate creditCardBodyWords / cardEndingRegex.

    // 10. BALANCE. Model span repaired via qualified-then-bare patterns,
    //     else body regex fallback.
    val avlBal: String = TODO()

    // 11. TYPE RECONCILIATION. KEEP THIS SHAPE: when the model's type head and
    //     the keyword scan disagree, THE KEYWORD WINS unless it said OTHER.
    //     A keyword is a fact in the text; the head is an inference.
    val transactionType: TxnType = TODO()

    // 12. SOURCE: model head, forced to CARD by step 9.
    val source: TxnSource = TODO()

    // 13. MERCHANT: model span, else body extraction.
    val merchant: String = TODO()

    // 14. FINAL VETO. Runs last, on the assembled row.
    val validator = TransactionRowValidator(region)
    if (validator.isInvalidRow(account, amount, body)) return null

    // 15. Feed AccountMemory so later account-less messages can inherit.
    AccountMemory.remember(listOf(senderBank, bankName, p?.bankSpan), account)

    return TransactionRow(
        bankName = bankName,
        accountNumber = account,
        amount = amount,
        avlBal = avlBal,
        merchantName = merchant,
        body = body,
        date = date,
        transactionType = transactionType.dbValue,
        address = address ?: "",
        logoKey = logoKey,
        messageId = messageId,
        typeId = typeId,
        thread = threadId,
        source = source.dbValue,
    )
}
