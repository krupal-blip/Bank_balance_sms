{
  "aba_algorithm": {
    "name": "Federal Reserve ABA Routing Modulo 10 Checksum",
    "formula": "(3*(d1 + d4 + d7) + 7*(d2 + d5 + d8) + 1*(d3 + d6 + d9)) mod 10 == 0",
    "kotlin_implementation": "fun validateAbaRouting(routing: String): Boolean { if (routing.length != 9 || !routing.all { it.isDigit() }) return false; val weights = intArrayOf(3, 7, 1, 3, 7, 1, 3, 7, 1); val sum = routing.map { it.toString().toInt() }.zip(weights.toList()) { d, w -> d * w }.sum(); return sum % 10 == 0; }"
  },
